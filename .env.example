# =============================================================================
# GoldScalper — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Ports use the 90xx block (avoids 8xxx, coexists with 9router).
# =============================================================================

# --- App ---
APP_NAME=GoldScalper
ENVIRONMENT=development
DEBUG=false

# --- API server ---
HOST=0.0.0.0
PORT=9090
API_TOKEN=change_me_to_a_long_random_string
CORS_ORIGINS=https://scalper.7pivot.site,http://localhost:9090

# --- Database (TimescaleDB) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=goldscalper
DB_PASSWORD=change_me_in_env
DB_NAME=goldscalper

# Values consumed by docker-compose services (timescaledb init)
POSTGRES_USER=goldscalper
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=goldscalper

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
# REDIS_PASSWORD=

# --- MT5 broker (EXNESS demo) ---
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=Exness-Real10
MT5_PATH=
MT5_SYMBOL=XAUUSD
MT5_MAGIC=990001
MT5_DEVIATION=20
MT5_MOCK=true

# --- Remote MT5 bridge (Windows host running the terminal) ---
# Leave empty if the bot runs on the same Windows host as MT5.
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=

# --- Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk / scalper tuning ---
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_CONSECUTIVE_LOSSES=3
MAX_SPREAD_POINTS=45
MAX_OPEN_POSITIONS=3
DEFAULT_RR=1.5
ATR_SL_MULTIPLIER=1.2
MAX_HOLD_SECONDS=600
CYCLE_INTERVAL_MS=1000

# --- Institutional SMC & Session Disciplines ---
NEWS_BLACKOUT_PRE_MINUTES=30
NEWS_BLACKOUT_POST_MINUTES=20
LONDON_OPEN_FREEZE_ENABLED=true
HARD_CUTOFF_UTC_ENABLED=true
OVERNIGHT_FLAT_UTC_ENABLED=true
D1_MACRO_BIAS_VETO_ENABLED=true
MICRO_SR_VETO_ENABLED=true
MICRO_SR_LOOKBACK_M1=20
MICRO_SR_CONFIRM_RANGE_USD=1.20

# --- The Juggler (Anti-Bleeding & Circuit Breaker) ---
JUGGLER_ENABLED=true
HARD_LOSS_CLAMP_ENABLED=true
HARD_LOSS_CLAMP_USD=7.00
LOSS_TIME_DECAY_SECONDS=180
LOSS_TIME_DECAY_MIN_LOSS_USD=2.00
DAILY_PROFIT_TARGET_PCT=35.0
DAILY_PROFIT_LOCK_ENABLED=true
DAILY_LOSS_LIMIT_PCT=15.0
LOT_SIZING_MODE=TARGET_SEEKING
TARGET_SEEKING_SWING_USD=3.00

# --- Multi-Timeframe Watchdog (Satpam Bertingkat M1, M5, M15) ---
WATCHDOG_ENABLED=true
WATCHDOG_MIN_HOLD_SECONDS=60
WATCHDOG_TIME_EXTENSION_SECONDS=300
WATCHDOG_EARLY_INVALIDATION_ENABLED=true
WATCHDOG_EARLY_LOSS_RATIO=0.40
FAST_BREAKEVEN_PIPS=12.0

# --- BizDev Engine (Rebate & Friction Tracker) ---
BIZDEV_ENABLED=true
REBATE_PER_LOT_USD=6.00
MAX_FRICTION_RATIO_PCT=15.0

# --- Learning loop ---
LEARNING_ENABLED=true
BANDIT_EXPLORATION=0.1
MIN_TRADES_FOR_WEIGHT_UPDATE=30
WEIGHT_MAX_DELTA_PCT=20.0

# --- Boot behavior ---
# Apply pending DB migrations on startup (bot container).
RUN_MIGRATIONS=true

# --- Cloudflare Tunnel (profile: tunnel) ---
# Token from Zero Trust -> Networks -> Tunnels. Leave empty to run without it.
TUNNEL_TOKEN=

# --- Bridge server (Windows host) ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=9095
BRIDGE_TOKEN=bridge_token_rahasia
BRIDGE_LOG_LEVEL=info
MT5_FILLING=IOC
